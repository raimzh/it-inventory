{
  // Сборка для деплоя — в отдельный каталог, а не поверх работающего dist.
  //
  // nest build с deleteOutDir: true (nest-cli.json) СНАЧАЛА стирает outDir.
  // Пока сборка идёт, каталог пуст; если боевой процесс в этот момент
  // перезапустится (упадёт сам или его перезапустит PM2), он не найдёт
  // main.js, исчерпает max_restarts и останется лежать. Отдельный каталог
  // это исключает: живой dist не трогается до самой подмены.
  //
  // Используется только из redeploy.ps1: nest build -p tsconfig.deploy.json
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-staging"
  }
}
