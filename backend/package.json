{
  "name": "it-inventory-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "lint": "eslint src --ext .ts",
    "test": "node --test test/stock.movements.test.js",
