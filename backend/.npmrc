# typeorm@1.1 объявляет ioredis как ОПЦИОНАЛЬНЫЙ peer ^5.0.4 — для своего
# встроенного Redis-кэша, которым проект не пользуется: у нас собственные
# CacheService и RedisThrottlerStorage на ioredis 6.
#
# Расхождение осознанное и постоянное (до обновления typeorm), но npm ci
# останавливается на нём с ERESOLVE. Флаг задан здесь, а не в каждой команде,
# чтобы CI, сборка образа и установка у разработчика вели себя одинаково.
legacy-peer-deps=true
