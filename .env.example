# dotenv (v17+) печатает в лог случайные рекламные "tips" при каждом старте,
# включая упоминание стороннего домена — подавляем, чтобы не засорять логи.
DOTENV_CONFIG_QUIET=true

# ─── Database ───────────────────────────────────────────────
DB_NAME=it_inventory
DB_USER=inventory
DB_PASSWORD=changeme_strong_password

# Применять миграции при старте приложения.
# true  — если пользователь БД владеет схемой (Docker, облако).
# пусто — если роль приложения без прав DDL; тогда миграции прогоняются
#         вручную привилегированной ролью: npm run migration:run
RUN_MIGRATIONS=true

# ─── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password

# ─── JWT ────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО. Значения по умолчанию в коде убраны намеренно: приложение
# не стартует, если секрет не задан, короче 16 символов или является
# известной заглушкой (см. backend/src/config/env.validation.ts).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Короткий срок жизни access-токена; непрерывность даёт refresh-токен
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_SECRET=
REFRESH_EXPIRES_IN=7d

# ─── Администратор (сид при первом запуске) ─────────────────
# Если не задать — сид пропускается. НЕ хардкодить в коде.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# ─── App URLs ───────────────────────────────────────────────
APP_URL=https://inventory.yourdomain.com
FRONTEND_URL=https://inventory.yourdomain.com
NEXT_PUBLIC_API_URL=https://inventory.yourdomain.com/api
NEXTAUTH_URL=https://inventory.yourdomain.com
NEXTAUTH_SECRET=your_nextauth_secret_min_32_chars

# ─── Mail ───────────────────────────────────────────────────
MAIL_HOST=smtp.yourdomain.com
MAIL_PORT=587
MAIL_USER=noreply@yourdomain.com
MAIL_PASS=mail_password
MAIL_FROM=IT Inventory <noreply@yourdomain.com>

# ─── Telegram Bot ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ─── 1C Integration ─────────────────────────────────────────
# OData REST API URL (1C:Enterprise 8.x)
ONE_C_URL=http://your-1c-server/base/odata/standard.odata
ONE_C_USER=1c_api_user
ONE_C_PASSWORD=1c_api_password
# Sync schedule (cron): daily at 06:00
ONE_C_SYNC_CRON=0 6 * * *

# ─── Backup ─────────────────────────────────────────────────
BACKUP_CRON=0 2 * * *

# Сколько дней держать копии В ЛОКАЛЬНОМ каталоге (BACKUP_DIR).
# 750 - около двух лет: годовую инвентаризацию должно быть с чем сравнить.
# 0 - хранить бессрочно, ротация выключена.
# Пусто - берётся значение по умолчанию (750).
# Любое иное значение (отрицательное, дробное, не число) ротацию ОТКЛЮЧАЕТ
# и пишет ошибку в журнал: удалить лишнее хуже, чем сохранить лишнее.
# Зеркало (BACKUP_MIRROR_DIR) этим сроком НЕ ограничено и не чистится вовсе.
BACKUP_RETENTION_DAYS=750

# Путь к pg_dump. На Windows каталог PostgreSQL обычно не в PATH, и без
# явного пути копия не создаётся вовсе (spawn pg_dump ENOENT).
# Пример: C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
PG_DUMP_PATH=

# Шифрование копий (AES-256-GCM). Дамп содержит всю базу, включая хэши
# паролей, поэтому в открытом виде он опаснее самой базы.
# Расшифровка: node backend/scripts/decrypt-backup.js <файл.sql.enc>
# ВАЖНО: потеря ключа = потеря всех копий. Храните его отдельно от них.
BACKUP_ENCRYPTION_KEY=

# Второе расположение для копий — сетевая папка или примонтированный диск.
# Без него копии лежат рядом с базой и пропадут вместе с машиной.
# Отсюда копии не удаляются НИКОГДА — это бессрочный архив, в отличие от
# локального каталога со скользящим окном. Следите за свободным местом и
# квотой: переполнение остановит синхронизацию, и новые копии перестанут
# покидать машину, а сбой дублирования только пишется в журнал.
BACKUP_MIRROR_DIR=

# При каком объёме архива копий предупреждать в журнале, в гигабайтах.
# 0 или пусто - не предупреждать.
# Это НЕ обнаруживает исчерпание облачной квоты: OneDrive при полном
# хранилище перестаёт синхронизировать молча, и увидеть это из приложения
# нечем. Предупреждение даёт запас времени по объёму, не более того.
BACKUP_MIRROR_WARN_GB=2

# ─── Уведомления склада ─────────────────────────────────────
# Расписание рассылки о позициях ниже точки заказа.
# Пусто — рассылка выключена (требует настроенной почты).
LOW_STOCK_CRON=0 9 * * 1
